# Copy to .env (same directory as this file's parent, i.e. the repo root) and
# fill in real values:
#   cp deploy/.env.example .env
#
# .env is read by two things:
#  - deploy/ragtrust.service's EnvironmentFile= (systemd), for production.
#  - src/ragtrust/service.py's _LazyASGIApp, which reads these same names
#    straight from os.environ (RAGTRUST_INDEX/RAGTRUST_GENERATOR/RAGTRUST_MODEL)
#    when `uvicorn ragtrust.service:app` is started directly (no CLI flags).
#
# Never commit the real .env -- it holds a live API key. Only this .example
# file (placeholder values only) belongs in git.

# --- LLM backend: OmniRoute, an OpenAI-compatible router running on the VPS
# --- itself (src/ragtrust/generation/openai_compat.py::OpenAICompatGenerator).
RAGTRUST_LLM_BASE_URL=http://127.0.0.1:20128
RAGTRUST_LLM_API_KEY=replace-with-the-real-omniroute-key
# One of the models OmniRoute's GET /v1/models reports, e.g. auto/best-fast,
# auto/best-reasoning, auto/best-coding.
RAGTRUST_LLM_MODEL=auto/best-reasoning

# --- Which generator backend service.py's _make_generator() should build.
# Set to "openai_compat" to use OmniRoute (see above). Other valid values:
# "ollama", "hf_api", "cached" -- see src/ragtrust/service.py::_make_generator.
RAGTRUST_GENERATOR=openai_compat

# --- Path to a saved index directory (built with `ragtrust index <corpus> --out
# --- <dir>`; see deploy/README.md step 3). Absolute path recommended since
# --- systemd's WorkingDirectory makes a relative one resolve from the repo root
# --- anyway, but being explicit here avoids ambiguity.
RAGTRUST_INDEX=/home/admin/projects/rag-trustworthiness-industrial/data/index

# Read timeout in seconds. A router fronting several providers can queue or
# cold-start, so a single completion may exceed a minute; 60s proved too tight
# against a live deployment and surfaced healthy-but-slow as "unreachable".
RAGTRUST_LLM_TIMEOUT=240

# --- Persisted document upload (POST /corpora, src/ragtrust/corpora.py). The
# --- systemd unit grants write access to /var/lib/ragtrust via
# --- StateDirectory=ragtrust + ReadWritePaths=/var/lib/ragtrust (see
# --- deploy/ragtrust.service) -- nowhere else under the hardened sandbox is
# --- writable, so this must point inside it.
RAGTRUST_UPLOAD_DIR=/var/lib/ragtrust/corpora

# Reject an upload above this size before it is fully buffered (service.py
# streams and checks in 1 MiB chunks) or indexed.
RAGTRUST_MAX_UPLOAD_MB=10

# Reject a PDF with more pages than this before extracting any text -- page
# count is checked first because extraction is unbounded work.
RAGTRUST_MAX_PDF_PAGES=100

# How long an uploaded corpus is kept before CorpusStore.sweep() deletes it.
RAGTRUST_CORPUS_TTL_HOURS=24

# Hard cap on the number of uploaded corpora kept on disk at once; sweep()
# deletes the oldest first once this is exceeded, independent of the TTL.
RAGTRUST_MAX_CORPORA=20

# How many uploaded corpora's indexes are kept warm in memory (an LRU) so a
# repeat query against a recently used corpus does not reload it from disk.
RAGTRUST_CORPUS_CACHE=4
